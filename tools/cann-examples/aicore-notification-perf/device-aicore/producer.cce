// producer.cce — AICore inner kernel. Single block (block_dim=1) on a single
// AIC. The kernel runs a mode-aware tight loop that publishes a monotonic
// counter + AICore-side sys_cnt via either:
//
//   mode == kNotifPerfModeGm:    write p_seq, write p_tw, dcci both fields,
//                                let the GM cache-coherency protocol carry
//                                the update to the AICPU's L1.
//   mode == kNotifPerfModeCond:  write p_tw, dcci, then `set_cond(FIN|seq)`
//                                via the SPR write — AICPU reads through
//                                MMIO at COND register.
//
// Producer reads `mode` and `go` from the GM handshake every iteration, so
// AICPU can switch subtest mid-flight without dropping go to 0 first.
// Throttle (configurable via handshake.throttle_iter) leaves time for the
// AICPU consumer to observe each update without queueing them up.
//
// Args contract (host passes via KernelArgs):
//   args[0] = &NotifPerfHandshake (GM device pointer)

// This kernel needs no AscendC header. dcci, dsb, set_cond, get_coreid and
// get_sys_cnt are all `-x cce` builtins, and the runtime's own AICore sources
// include no AscendC header either. Including kernel_operator.h would pull in
// non-weak globals (g_tilingKey among them) that break the combined link of the
// mix pair, and would tie the build to where a given CANN release puts its
// tikcpp subtree.

#include "../shared/handshake.h"

#ifndef __aicore__
#define __aicore__ [aicore]
#endif

// rtRegisterAllKernel enumerates kernels by the `<name>_0_mix_aic` /
// `_0_mix_aiv` symbol pair and the registered ELF must carry both halves; a
// plainly-named entry is rejected with 107000. Same shape as
// src/a2a3/platform/onboard/aicore/kernel.cpp.
#ifdef __DAV_VEC__
#define PRODUCER_ENTRY notif_perf_producer_0_mix_aiv
#else
#define PRODUCER_ENTRY notif_perf_producer_0_mix_aic
#endif

extern "C" __global__ __aicore__ void PRODUCER_ENTRY(__gm__ NotifPerfHandshake *hank) {
#ifdef __DAV_VEC__
    // The vector half exists only to complete the mix pair; the measurement
    // runs entirely on the cube.
    (void)hank;
    return;
#else
    if (hank == nullptr) {
        return;
    }

    // Wait until AICPU sets go=1. AICore's L1 cache for GM is non-coherent
    // with AICPU writes, so dcci-invalidate the line before re-reading each
    // time. Without dcci, AICore's L1 caches go=0 forever.
    //
    // Bounded: a consumer that never launched, or died before releasing the
    // producer, would otherwise leave this kernel spinning and the host blocked
    // in aclrtSynchronizeStream with nothing to report.
    bool released = false;
    uint64_t go_t0 = get_sys_cnt();
    while (get_sys_cnt() - go_t0 < kNotifPerfProducerGoWaitTicks) {
        dcci(reinterpret_cast<__gm__ uint64_t *>(hank), SINGLE_CACHE_LINE);
        if (hank->go == 1) {
            released = true;
            break;
        }
    }
    if (!released) {
        hank->producer_rc = kNotifPerfProducerGoTimeout;
        dcci(&hank->producer_rc, SINGLE_CACHE_LINE, CACHELINE_OUT);
        dsb(DSB_DDR);
        return;
    }

    // block_dim=1 does not pin this kernel to AIC[0], and the consumer polls one
    // core's COND register, so it has to learn which core this is rather than
    // assume. Published raw; the consumer applies AICORE_COREID_MASK and keeps
    // both values, so a surprising id is visible rather than silently folded.
    //
    // Published after go rather than at entry: the consumer clears
    // core_id_valid as part of its own setup, and this kernel reports once, so
    // a report written before that clear would be erased and never repeated.
    hank->core_id = static_cast<uint32_t>(get_coreid());
    hank->core_id_valid = 1;
    dcci(&hank->core_id, SINGLE_CACHE_LINE, CACHELINE_OUT);
    dsb(DSB_DDR);

    uint64_t seq = 0;
    uint32_t rc = kNotifPerfProducerOk;
    uint64_t run_t0 = get_sys_cnt();
    while (true) {
        // Re-read mode + go each iter. Line 0 of the handshake holds only the
        // AICPU-owned {go, mode, throttle_iter, _pad0}, so a single
        // SINGLE_CACHE_LINE dcci refreshes all of them — and because nothing
        // this kernel writes lives on that line, no CACHELINE_OUT below can
        // push a stale copy of them back over the consumer's updates.
        dcci(reinterpret_cast<__gm__ uint64_t *>(hank), SINGLE_CACHE_LINE);
        if (hank->go == 0) {
            break;
        }
        if (get_sys_cnt() - run_t0 > kNotifPerfProducerRunTicks) {
            rc = kNotifPerfProducerRunTimeout;
            break;
        }
        uint32_t mode = hank->mode;
        uint32_t throttle = hank->throttle_iter;

        seq++;
        uint64_t tw = get_sys_cnt();

        if (mode == kNotifPerfModeGm) {
            // Order matters: write tw FIRST so by the time AICPU observes
            // the new p_seq, the paired tw is already in GM. dcci flushes the
            // cache line containing both fields together.
            hank->p_tw = tw;
            hank->p_seq = seq;
            dcci(&hank->p_seq, SINGLE_CACHE_LINE, CACHELINE_OUT);
        } else {
            // COND path: tw must still be visible to AICPU so it can compute
            // the (t_obs - tw) latency once it sees the COND change.
            //
            // dcci issues the write-back without waiting for it, and set_cond
            // is an SPR write that does not travel with it, so the barrier is
            // what keeps tw ahead of the notification carrying its sequence.
            // Without it the consumer can observe COND and still read the
            // previous tw, which makes t_obs - tw meaningless (usually
            // negative, so the sample is not merely noisy but unusable). Same
            // requirement the runtime's own FIN path carries (#2233 / #2324).
            hank->p_tw = tw;
            dcci(&hank->p_tw, SINGLE_CACHE_LINE, CACHELINE_OUT);
            dsb(DSB_DDR);
            // Write COND via SPR — production set_cond writes the same FIN
            // encoding the scheduler expects.
            uint32_t cond_val = (static_cast<uint32_t>(seq) & kNotifPerfTaskIdMask) | kNotifPerfTaskStateMask;
            set_cond(cond_val);
        }

        // Throttle: a short spin so AICPU has time to observe each update.
        // Empirically ~50 iter ≈ 1 µs on a3 AICore. Read once and let the
        // compiler hoist the bound — the inner volatile keeps it from being
        // optimised away entirely.
        for (volatile uint32_t s = 0; s < throttle; s++) {
            // empty
        }
    }

    hank->producer_rc = rc;
    dcci(&hank->producer_rc, SINGLE_CACHE_LINE, CACHELINE_OUT);
    dsb(DSB_DDR);
#endif
}
