# Host serializes an immutable graph; independent PEs initialize and execute it.
function(simpler_wse_default_array output json section field count)
    string(JSON kind TYPE "${json}" "${section}" "${field}")
    if(kind STREQUAL "ARRAY")
        string(JSON length LENGTH "${json}" "${section}" "${field}")
        if(NOT length EQUAL count)
            message(FATAL_ERROR "WSE ${field} array must match core_count")
        endif()
    elseif(NOT kind STREQUAL "NUMBER")
        message(FATAL_ERROR "WSE ${field} must be an integer or array")
    endif()
    set(values "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        if(kind STREQUAL "ARRAY")
            string(JSON value GET "${json}" "${section}" "${field}" ${index})
        else()
            string(JSON value GET "${json}" "${section}" "${field}")
        endif()
        if(NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "WSE ${field} must contain unsigned integers")
        endif()
        string(APPEND values "${value}ULL,")
    endforeach()
    set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(simpler_configure_wse_hardware target)
    get_filename_component(wse_root "${CMAKE_CURRENT_SOURCE_DIR}/../.." ABSOLUTE)
    set(wse_config "${wse_root}/config/default_simulation.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${wse_config}")
    file(READ "${wse_config}" wse_json)
    foreach(section IN ITEMS hardware runtime)
        string(JSON length LENGTH "${wse_json}" ${section})
        math(EXPR last "${length} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON key MEMBER "${wse_json}" ${section} ${index})
            if(section STREQUAL "hardware")
                if(NOT key MATCHES "^(core_count|pe_per_core|sram_bytes_per_core)$")
                    message(FATAL_ERROR "Unknown WSE hardware field: ${key}")
                endif()
            elseif(NOT key STREQUAL "sram_reserve_bytes_per_core")
                message(FATAL_ERROR "Unknown WSE runtime field: ${key}")
            endif()
        endforeach()
    endforeach()
    string(JSON top_count LENGTH "${wse_json}")
    if(NOT top_count EQUAL 2)
        message(FATAL_ERROR "WSE defaults require only hardware and runtime sections")
    endif()
    string(JSON wse_cores GET "${wse_json}" hardware core_count)
    string(JSON wse_pes GET "${wse_json}" hardware pe_per_core)
    file(STRINGS "${wse_root}/include/common/hardware_spec.h" max_line REGEX "MAX_CORE_COUNT =")
    string(REGEX REPLACE ".*= ([0-9]+);.*" "\\1" max_cores "${max_line}")
    if(NOT wse_cores MATCHES "^[0-9]+$" OR wse_cores LESS 1 OR wse_cores GREATER max_cores)
        message(FATAL_ERROR "WSE default core_count exceeds compiled capability")
    endif()
    if(NOT wse_pes MATCHES "^[0-9]+$")
        message(FATAL_ERROR "WSE pe_per_core must be an integer")
    endif()
    simpler_wse_default_array(capacities "${wse_json}" hardware sram_bytes_per_core ${wse_cores})
    simpler_wse_default_array(reserves "${wse_json}" runtime sram_reserve_bytes_per_core ${wse_cores})
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/wse_hardware_defaults.h"
        "#pragma once\n#include <cstdint>\nnamespace wse {\ninline constexpr unsigned DEFAULT_CORES = ${wse_cores};\ninline constexpr unsigned DEFAULT_PES = ${wse_pes};\ninline constexpr uint64_t DEFAULT_CAPACITIES[] = {${capacities}};\ninline constexpr uint64_t DEFAULT_RESERVES[] = {${reserves}};\n}\n")
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
endfunction()
